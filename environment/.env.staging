# ================================================================
# Application
# ================================================================
APP_MODE=multi_tenant
IS_PRODUCTION=true
IS_DEBUG=false

# ================================================================
# Database
# ================================================================
# Staging server
DB_HOST=187.124.138.11
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=recognize_cctv
DB_TYPE=postgresql

# ================================================================
# CCTV Recognition
# ================================================================
FACE_MODEL_PATH=./models/yolo/yolo26n-face.pt
CAMERA_SOURCE=
CCTV_RECOGNITION_ENABLED=true
CCTV_MONITOR_MODE=attendance
CCTV_MAX_CAMERAS_PER_COMPANY=2
HRMS_TOKEN=
HRMS_BRANCH_ID=
HRMS_EMPLOYEE_LIMIT=100
ATTENDANCE_PHOTOS_URL=https://api-hrms.duluin.com/api/proxy/v1/attendance/attendance/photos

# Face detection and recognition
SIMILARITY_THRESHOLD=0.80
FACE_CROP_MARGIN=0.25
REGISTERED_FACE_MIN_CONFIDENCE=0.4
DETECTION_MIN_CONFIDENCE=0.5
DETECT_WIDTH=480
TRACK_IOU_THRESHOLD=0.35
TRACK_CONFIRM_HITS=5
TRACK_MAX_MISSED_FRAMES=12
VECTOR_DB_PATH=./vector_db
VECTOR_DB_COLLECTION=employee_faces

# AI optimization
REID_SIMILARITY_THRESHOLD=0.82
REID_MAX_AGE_SECONDS=5.0
CLAHE_BRIGHTNESS_THRESHOLD=85.0
MIN_FACE_WIDTH=32
MIN_FACE_HEIGHT=32
MIN_FACE_BRIGHTNESS=28.0
MIN_FACE_BLUR=18.0
ADAPTIVE_FRAME_SKIP_ENABLED=false
TARGET_INFERENCE_MS=120
MAX_FRAME_SKIP=3

# Attendance snapshots
ATTENDANCE_SNAPSHOT_ENABLED=true
ATTENDANCE_SNAPSHOT_BASE_URL=/static/attendance_snapshots
ATTENDANCE_SNAPSHOT_PADDING_RATIO=0.75
ATTENDANCE_POLICY_URL=

# ================================================================
# Event Visitor
# ================================================================
EVENT_VISITOR_VECTOR_DB_COLLECTION=event_visitors
EVENT_VISITOR_SIMILARITY_THRESHOLD=0.70
EVENT_VISITOR_DETECT_EVERY_N_FRAMES=8
EVENT_VISITOR_DETECT_WIDTH=416
EVENT_VISITOR_TRACK_IOU_THRESHOLD=0.25
EVENT_VISITOR_TRACK_MAX_MISSED_FRAMES=12
EVENT_VISITOR_GENDER_MODEL_PATH=./models/gender/gender_net.caffemodel
EVENT_VISITOR_GENDER_CONFIG_PATH=./models/gender/deploy.prototxt
EVENT_VISITOR_GENDER_CONFIDENCE_THRESHOLD=0.65

EVENT_VISITOR_PERSON_MODEL_PATH=
EVENT_VISITOR_PERSON_CONFIDENCE_THRESHOLD=0.45

# ================================================================
# Password Reset Email
# ================================================================
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ================================================================
# RabbitMQ
# ================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ATTENDANCE_IN_ROUTING_KEY=workin.attendance.in
RABBITMQ_ATTENDANCE_OUT_ROUTING_KEY=workin.attendance.out
RABBITMQ_CAMERA_START_ROUTING_KEY=workin.cctv.camera.start

# ================================================================
# Logging
# ================================================================
LOG_MASKING_ENABLED=true
LOG_MASK_FIELDS=token,password,secret,authorization,access_token,refresh_token,api_key
LOG_UNMASK_FIELDS=
LOG_MAX_VALUE_LENGTH=2000
LOG_MAX_COLLECTION_ITEMS=30
LOG_MAX_BODY_PREVIEW_LENGTH=1000
LOG_PRETTY_JSON=true
